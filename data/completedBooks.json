-05:00"}],"completed":true,"lastReadingProgressUtc":"2026-05-30T19:48:00.716908","lastReadingProgressLocal":"2026-05-30T19:48:00.716908-05:00"}],"completed":true,"completion_progress":1.0}},{"volume":{"id":84,"name":"","pages":108,"pagesRead":108,"wordCount":133303,"chapters":[{"id":86,"titleName":"The Complete Gary Lutz","sortOrder":-100000.0,"lastReadingProgressUtc":"2026-05-30T19:48:13.391039","lastReadingProgressLocal":"2026-05-30T19:48:13.391039-05:00"}],"completed":true,"lastReadingProgressUtc":"2026-05-30T19:48:13.391039","lastReadingProgressLocal":"2026-05-30T19:48:13.391039-05:00"},"series":{"id":68,"name":"","pages":108,"pagesRead":108,"latestReadDate":"2026-05-30T19:48:13.391036","metadata":{"summary":"<div>\n<p>For nearly three decades, Gary Lutz has been writing quietly influential, virtuosic short fictions of antic despair. In barbed sentences of startling originality, Lutz gives voice to outcasts from conventional genders and monogamies--and even from the ruckus of their own bodies. Making their rounds of daily humiliations, Lutz's self-unnerving narrators find themselves helplessly trespassing on their own lives. This omnibus volume, with an introduction by Brian Evenson, gathers all five of Lutz's sometimes hard-to-find collections and features sixty pages of previously uncollected stories--including his two longest.</p></div>","tags":[],"webLinks":["about:blank"]},"volumes":[{"id":84,"name":"","pages":108,"pagesRead":108,"wordCount":133303,"chapters":[{"id":86,"titleName":"The Complete Gary Lutz","sortOrder":-100000.0,"lastReadingProgressUtc":"2026-05-30T19:48:13.391039","lastReadingProgressLocal":"2026-05-30T19:48:13.391039-05:00"}],"completed":true,"lastReadingProgressUtc":"2026-05-30T19:48:13.391039","lastReadingProgressLocal":"2026-05-30T19:48:13.391039-05:00"}],"completed":true,"completion_progress":1.0}},{"volume":{"id":85,"name":"","pages":10,"pagesRead":10,"wordCount":183720,"chapters":[{"id":87,"titleName":"The Gotham Grammarian","sortOrder":-100000.0,"lastReadingProgressUtc":"2026-05-30T19:48:24.089837","lastReadingProgressLocal":"2026-05-30T19:48:24.089837-05:00"}],"completed":true,"lastReadingProgressUtc":"2026-05-30T19:48:24.089837","lastReadingProgressLocal":"2026-05-30T19:48:24.089837-05:00"},"series":{"id":69,"name":"","pages":10,"pagesRead":10,"latestReadDate":"2026-05-30T19:48:24.089836","metadata":{"summary":"A practical guide for readers and editors who value correctness and precision, The Gotham Grammarian examines 95 common syntax, grammar, punctuation, and usage errors found in otherwise excellent writing. Using real examples from respected publications (flagged with a banana-peel icon), it explains what went wrong and offers corrected revisions, drawing on standard reference works and Merriam-Webster for spelling.","tags":[],"webLinks":["https://calamaripress.com/Gotham_Grammarian.htm"]},"volumes":[{"id":85,"name":"","pages":10,"pagesRead":10,"wordCount":183720,"chapters":[{"id":87,"titleName":"The Gotham Grammarian","sortOrder":-100000.0,"lastReadingProgressUtc":"2026-05-30T19:48:24.089837","lastReadingProgressLocal":"2026-05-30T19:48:24.089837-05:00"}],"completed":true,"lastReadingProgressUtc":"2026-05-30T19:48:24.089837","lastReadingProgressLocal":"2026-05-30T19:48:24.089837-05:00"}],"completed":true,"completion_progress":1.0}},{"volume":{"id":56,"name":"","pages":346,"pagesRead":346,"wordCount":814762,"chapters":[{"id":56,"titleName":"The Artist Who Paints Dungeon","sortOrder":-100000.0,"lastReadingProgressUtc":"2026-05-30T19:48:44.569728","lastReadingProgressLocal":"2026-05-30T19:48:44.569728-05:00"},{"id":83,"titleName":"The Artist Who Paints Dungeon","sortOrder":-99999.9,"lastReadingProgressUtc":"2026-05-30T19:48:44.569749","lastReadingProgressLocal":"2026-05-30T19:48:44.569749-05:00"}],"completed":true,"lastReadingProgressUtc":"2026-05-30T19:48:44.569749","lastReadingProgressLocal":"2026-05-30T19:48:44.569749-05:00"},"series":{"id":51,"name":"","pages":346,"pagesRead":346,"late